# /etc/allstar/allstar.env 로 복사한 뒤 실제 값을 입력합니다.
# 이 파일의 실제 운영본은 Git에 올리지 않습니다.

ALLSTAR_COMPOSE_PROJECT=allstar
ALLSTAR_DOMAIN=allstarqa.duckdns.org
ALLSTAR_SITE_ADDRESS=allstarqa.duckdns.org
ALLSTAR_PUBLIC_URL=https://allstarqa.duckdns.org
ALLSTAR_HTTP_PORT=80
ALLSTAR_HTTPS_PORT=443
ALLSTAR_DATA_ROOT=/opt/allstar-data
PROMETHEUS_RETENTION=30d

DASHBOARD_TEST_TABS_PASSWORD=1234

# 32바이트 이상의 임의값을 권장합니다.
SERVICE_CONTROL_TOKEN=
GRAFANA_ADMIN_PASSWORD=

AI_CHAT_MODEL=openai.gpt-oss-20b
AI_JUDGE_MODEL=openai.gpt-oss-120b
AI_CHAT_REASONING=low
AI_JUDGE_REASONING=low
VOC_OPENAI_GENERATION_MODEL=openai.gpt-oss-20b
VOC_OPENAI_JUDGE_MODEL=openai.gpt-oss-120b
VOC_ANTHROPIC_GENERATION_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
VOC_ANTHROPIC_JUDGE_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
VOC_OPENAI_GENERATION_REASONING=low
VOC_OPENAI_JUDGE_REASONING=low
VOC_ANTHROPIC_GENERATION_EFFORT=none
VOC_ANTHROPIC_JUDGE_EFFORT=none
VOC_ANTHROPIC_THINKING=disabled
INTERPRETER_MAX_OUTPUT_TOKENS=900

AWS_REGION=ap-northeast-2
AWS_DEFAULT_REGION=ap-northeast-2
BEDROCK_RUNTIME_REGION=ap-northeast-2
BEDROCK_MANTLE_REGION=us-west-2
S3_BUCKET=
S3_PREFIX=allstar
